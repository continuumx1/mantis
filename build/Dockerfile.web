# KNW frontend service (knw-web): serves the UI, proxies /api to knw-engine.
# The UI is embedded in the binary at compile time (go:embed), so the runtime
# image carries no separate assets.
#
#   docker build -f build/Dockerfile.web -t knw-web:dev .
#
# Note: the builder tag must match the Go toolchain in go.mod (currently 1.26).
FROM golang:1.26 AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/knw-web ./cmd/knw-web

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/knw-web /knw-web
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/knw-web"]
